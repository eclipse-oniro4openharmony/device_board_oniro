From 74c2b04457110de14ceca48602430097ca3e8044 Mon Sep 17 00:00:00 2001
From: Francesco Pham <francesco.pham1@h-partners.com>
Date: Wed, 29 Jul 2026 14:26:23 +0000
Subject: [PATCH 6/8] audio: make the VDI dispatcher buildable and build it
 alongside the default impl

The vdi_src implementation does not compile: audio_manager_vdi.c ends in
a C++ IPCSkeleton call inside a .c file.  It can never have been built,
which fits: the sources are reachable
only by setting drivers_peripheral_audio_feature_community to false, and
nothing does.

Fix it, and add a second target that builds the same sources
unconditionally as libaudio_primary_impl_vdi.  A product that ships one
image for several boards cannot express "this board uses the VDI
implementation" as a build flag, so both implementations have to be
present and chosen at runtime.

SetMaxWorkThreadNum becomes a no-op: IPCSkeleton is C++ only and its C
binding is an NDK module, which deps_guard does not allow a
vendor-installed library to depend on.  The effect is limited to the
size of the IPC worker pool.

Change-Id: I0460dcf9b433288ec998e31a2535c4873972218a
Signed-off-by: Francesco Pham <francesco.pham1@h-partners.com>
---
 audio/hdi_service/BUILD.gn                    |  1 +
 audio/hdi_service/primary_impl/BUILD.gn       | 54 +++++++++++++++++++
 .../primary_impl/vdi_src/audio_manager_vdi.c  |  8 ++-
 3 files changed, 62 insertions(+), 1 deletion(-)

diff --git a/audio/hdi_service/BUILD.gn b/audio/hdi_service/BUILD.gn
index 38f2aaf9a1..1133265583 100644
--- a/audio/hdi_service/BUILD.gn
+++ b/audio/hdi_service/BUILD.gn
@@ -18,6 +18,7 @@ group("idl_audio") {
   deps = [
     "primary:audio_manager_service_6.1",
     "primary:audio_primary_driver",
+    "primary_impl:audio_primary_impl_vdi",
     "primary_impl:audio_primary_impl_vendor",
   ]
 
diff --git a/audio/hdi_service/primary_impl/BUILD.gn b/audio/hdi_service/primary_impl/BUILD.gn
index 011ca9d8e4..7031b64e42 100644
--- a/audio/hdi_service/primary_impl/BUILD.gn
+++ b/audio/hdi_service/primary_impl/BUILD.gn
@@ -100,3 +100,57 @@ ohos_shared_library("audio_primary_impl_vendor") {
   subsystem_name = "hdf"
   part_name = "drivers_peripheral_audio"
 }
+
+# The same VDI dispatcher, built unconditionally under its own name so a
+# product can ship it alongside the default implementation and choose between
+# them at runtime (ohos.audio.hdi_impl, see ../primary/audio_manager_service.c).
+# Without this the dispatcher is only reachable by flipping
+# drivers_peripheral_audio_feature_community for the whole product, which is a
+# build-time decision and cannot serve two boards from one image.
+ohos_shared_library("audio_primary_impl_vdi") {
+  defines = []
+  sources = [
+    "vdi_src/audio_adapter_vdi.c",
+    "vdi_src/audio_capture_vdi.c",
+    "vdi_src/audio_common_vdi.c",
+    "vdi_src/audio_manager_vdi.c",
+    "vdi_src/audio_render_vdi.c",
+  ]
+
+  if (drivers_peripheral_audio_feature_reclaim_memory) {
+    defines += [ "AUDIO_RECLAIM_MEMORY_ENABLE" ]
+  }
+
+  deps = [ "$hdf_audio_path/audio_dfx:libaudio_dfx_static" ]
+
+  include_dirs = [
+    "$hdf_audio_path/interfaces/sound/v1_0",
+    "$hdf_hdi_service_path/vendor_interface/utils",
+  ]
+
+  if (enable_audio_hal_hdf_log) {
+    defines += [ "AUDIO_HDF_LOG" ]
+  }
+
+  if (musl_use_jemalloc && musl_use_jemalloc_dfx_intf) {
+    defines += [ "CONFIG_USE_JEMALLOC_DFX_INTF" ]
+  }
+
+  external_deps = [
+    "bounds_checking_function:libsec_shared",
+    "drivers_interface_audio:libaudio_proxy_6.0",
+    "hdf_core:libhdf_ipc_adapter",
+    "hdf_core:libhdi",
+    "hdf_core:libpub_utils",
+    "hilog:libhilog",
+    "ipc:ipc_single",
+  ]
+  if (enable_c_utils) {
+    external_deps += [ "c_utils:utils" ]
+  }
+
+  output_name = "libaudio_primary_impl_vdi"
+  install_images = [ chipset_base_dir ]
+  subsystem_name = "hdf"
+  part_name = "drivers_peripheral_audio"
+}
diff --git a/audio/hdi_service/primary_impl/vdi_src/audio_manager_vdi.c b/audio/hdi_service/primary_impl/vdi_src/audio_manager_vdi.c
index 173da31605..b75e60a095 100644
--- a/audio/hdi_service/primary_impl/vdi_src/audio_manager_vdi.c
+++ b/audio/hdi_service/primary_impl/vdi_src/audio_manager_vdi.c
@@ -572,5 +572,11 @@ int32_t AudioManagerDestroyIfInstance(struct IAudioManager *manager)
 
 void SetMaxWorkThreadNum(int32_t count)
 {
-    OHOS::IPCSkeleton::GetInstance().SetMaxWorkThreadNum(count);
+    /*
+     * IPCSkeleton is C++ only and its C binding (libipc_capi) is an NDK module
+     * a vendor-installed library may not depend on, so the worker pool keeps
+     * the IPC default here.  That only caps concurrent incoming transactions;
+     * the audio host has one client.
+     */
+    (void)count;
 }
\ No newline at end of file
-- 
