From 7f11c52e1c5f1e594e7cf6844109b780bd789bec Mon Sep 17 00:00:00 2001
From: Francesco Pham <francesco.pham1@h-partners.com>
Date: Wed, 11 Nov 2026 15:43:44 +0000
Subject: [PATCH 6/6] oniro: the Oniro HAP set also replaces stock HAPs on both
 emulators

The x86_general product became emulator_x86_64, and emulator_arm64 joined it. Both take vendor/oniro's HAP set like hybris_generic.

Change-Id: I932b74371c03e9440c120f7d4fdead3e468f2227
Signed-off-by: Francesco Pham <francesco.pham1@h-partners.com>
---
 BUILD.gn | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/BUILD.gn b/BUILD.gn
index daaf4c3..2eac3e4 100755
--- a/BUILD.gn
+++ b/BUILD.gn
@@ -527,9 +527,11 @@ group("hap") {
     deps +=
         [ "//applications/standard/admin_provisioning:adminprovisioning_hap" ]
   } else if (defined(product_name) &&
-             (product_name == "hybris_generic" || product_name == "x86_general")) {
-    # The two Oniro products (the phones and the emulator) share vendor/oniro's
-    # HAP set.
+             (product_name == "hybris_generic" ||
+              product_name == "emulator_x86_64" ||
+              product_name == "emulator_arm64")) {
+    # The Oniro products (the phones and the x86_64 and arm64 emulators) share
+    # vendor/oniro's HAP set.
     #
     # With the Oniro HAP set opted in, com.ohos.camera ships from vendor/oniro
     # instead: a rebuild of //applications/standard/camera that fixes the
-- 
2.50.1

