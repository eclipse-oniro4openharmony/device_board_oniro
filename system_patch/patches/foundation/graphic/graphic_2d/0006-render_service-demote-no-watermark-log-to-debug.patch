From 2d76cdf6ddd289ed5e50d7a9a273206d67dce4ea Mon Sep 17 00:00:00 2001
From: Francesco Pham <francesco.pham1@h-partners.com>
Date: Mon, 27 Jul 2026 15:54:21 +0000
Subject: [PATCH 6/9] render_service: demote no-watermark log to debug
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

DrawCommSurfaceWatermark logged at error level whenever a surface has no
watermark — the normal case for every surface on every frame — flooding
hilog from the render thread (37k lines in one buffer window) during
interaction.

Change-Id: Iada288fc0609baef964b0730f7d74b193d90728e
Signed-off-by: Francesco Pham <francesco.pham1@h-partners.com>
---
 .../core/feature/watermark/rs_surface_watermark.cpp             | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/rosen/modules/render_service/core/feature/watermark/rs_surface_watermark.cpp b/rosen/modules/render_service/core/feature/watermark/rs_surface_watermark.cpp
index df2cd90d2ac..9fa19759878 100644
--- a/rosen/modules/render_service/core/feature/watermark/rs_surface_watermark.cpp
+++ b/rosen/modules/render_service/core/feature/watermark/rs_surface_watermark.cpp
@@ -26,7 +26,7 @@ void RSSurfaceWatermarkHelper::DrawCommSurfaceWatermark(RSPaintFilterCanvas& can
     const RSSurfaceRenderParams& params)
 {
     if (params.IsSystemWatermarkEmpty() && params.IsCustomWatermarkEmpty()) {
-        RS_LOGE("RSSurfaceWatermarkHelper::DrawCommSurfaceWatermark Name:%{public}s Id:%{public}" PRIu64
+        RS_LOGD("RSSurfaceWatermarkHelper::DrawCommSurfaceWatermark Name:%{public}s Id:%{public}" PRIu64
             " water mark count is zero", params.GetName().c_str(), params.GetId());
         return;
     }
