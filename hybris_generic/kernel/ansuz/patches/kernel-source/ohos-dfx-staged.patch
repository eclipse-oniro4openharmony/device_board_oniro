+ * Copyright (c) 2023 Huawei Device Co., Ltd.
+ */
+#ifndef __UNIFIED_COLLECTION_DATA__
+#define __UNIFIED_COLLECTION_DATA__
+
+#include <linux/ioctl.h>
+
+// kernel struct, modify at the same time
+struct ucollection_process_cpu_item {
