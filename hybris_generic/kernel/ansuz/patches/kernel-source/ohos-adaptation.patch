diff --git a/arch/arm64/configs/openharmony.config b/arch/arm64/configs/openharmony.config
new file mode 100644
index 000000000..62e57f936
--- /dev/null
+++ b/arch/arm64/configs/openharmony.config
@@ -0,0 +1,18 @@
+# OpenHarmony driver enablement for the ansuz (Volla Phone Plinius)
+# android14-6.1-halium GKI kernel — stage 1 (minimal boot set).
+#
+# KMI rule for every addition here: nothing may change the layout of a
+# struct that stock prebuilt vendor modules see, and no existing
+# exported symbol's signature may change (CONFIG_MODVERSIONS CRCs).
+# access_tokenid deliberately keeps its tokens OUT of task_struct — see
+# drivers/accesstokenid/access_token_store.c in ohos-adaptation.patch.
+#
+# Staged later (mirroring the X23 set as needs prove out): HDF, hmdfs,
+# sharefs, hyperhold, hisysevent, blackbox, hungtask, zerohung, HCK.
+
+CONFIG_ACCESS_TOKENID=y
+CONFIG_HILOG=y
+CONFIG_HILOG_BUFFER_SIZE=4096
+CONFIG_HIEVENT=y
+CONFIG_BBOX_BUFFER_SIZE=2048
+CONFIG_BINDER_SENDER_INFO=y
