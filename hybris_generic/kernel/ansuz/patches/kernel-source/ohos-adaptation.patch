+# SPDX-License-Identifier: GPL-2.0
+config ACCESS_TOKENID
+	bool "Access task's token"
+	depends on TRACEPOINTS
+	default n
+	help
+	  OpenHarmony access token id driver (/dev/access_token_id).
+	  This port keeps tokens in an external store (tracepoint-driven)
+	  instead of task_struct fields so the GKI KMI stays intact.
