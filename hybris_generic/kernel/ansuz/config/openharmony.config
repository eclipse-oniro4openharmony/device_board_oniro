# OpenHarmony driver enablement for the ansuz (Volla Phone Plinius)
# android14-6.1-halium GKI kernel — stage 1 (minimal boot set).
#
# KMI rule for every addition here: nothing may change the layout of a
# struct that stock prebuilt vendor modules see, and no existing
# exported symbol's signature may change (CONFIG_MODVERSIONS CRCs).
# access_tokenid deliberately keeps its tokens OUT of task_struct — see
# drivers/accesstokenid/access_token_store.c in ohos-adaptation.patch.
#
# Staged later (mirroring the X23 set as needs prove out): HDF,
# hyperhold, HCK.  (sharefs/epfs/DEC + the DFX set landed 2026-08-02 as
# stage 2, below.  RTG/qos_auth stay out for good: they need task_struct
# growth, which the KMI rule forbids.)

CONFIG_ACCESS_TOKENID=y
CONFIG_HILOG=y
CONFIG_HILOG_BUFFER_SIZE=4096
CONFIG_HIEVENT=y
CONFIG_BBOX_BUFFER_SIZE=2048
CONFIG_BINDER_SENDER_INFO=y

#
# HMDFS — OHOS distributed filesystem.  Built-in so storage_daemon's
# `-t hmdfs` mount of /mnt/hmdfs/<uid>/account succeeds during user
# activation.  Without it that mount fails ENODEV, which aborts
# PrepareStartUser and leaves account 100 unverified *forever* — no
# COMMON_EVENT_USER_UNLOCKED, so medialibrary self-kills and every
# consumer of it (the camera app, the gallery) hangs.  Source is dropped
# into fs/hmdfs/ by build_kernel.sh (hmdfs.patch).
#
# ENCRYPTION is left off: it `depends on TLS` and only covers the
# cross-device socket transport, which this single-device build never
# uses — the account mount is purely device-local.
#
# KMI: hmdfs adds only fs/hmdfs/ plus two anchors in fs/Kconfig and
# fs/Makefile.  It touches no struct a stock vendor module sees and
# changes no existing export, so the CRC contract is untouched.
#
CONFIG_HMDFS_FS=y
# CONFIG_HMDFS_FS_ENCRYPTION is not set
CONFIG_HMDFS_FS_PERMISSION=y

#
# ---- stage 2 (2026-08-02): sharefs/epfs/DEC + DFX drivers ----
# All additions are self-contained fs/ or drivers/staging/ subsystems
# plus two guarded core touches: kernel/hung_task.c (hands the checking
# loop to htbase_check_tasks — all static functions, no export changes)
# and one line in security/selinux/hooks.c (sharefs in the SE_SBGENFS
# list).  KMI: no struct a stock module sees changes; guard must stay
# green.
#

# sharefs — inter-app file sharing overlay FS.  Backs storage_daemon's
# /mnt/share/<uid> (cross-app file:// URI grants) and the
# /mnt/user/<uid>/currentUser/other Docs view (/storage/Users).
# CONFIG_SHAREFS_SUPPORT_OVERRIDE is dead Kconfig in the 6.6 sources
# (never #ifdef'd) — the real switch is the "override" mount option.
CONFIG_SHARE_FS=y

# epfs — byte-range proxy fs used by medialibrary's EXIF/GPS redaction.
CONFIG_EPFS=y

# DEC — sandbox_manager's MAC backend (/dev/dec, LSM "dec_lsm").
# Registers imperatively via security_add_hooks at device_initcall, so
# it needs no lsm= cmdline entry.  SECURITY_PATH is off in gki_defconfig
# and required for the path_* hooks.  The OHOS-added path_access LSM
# hook is NOT taken (needs core edits); file_open/file_permission still
# gate all real I/O.  Token reads go through the external store
# (ohos_access_token.h) — task_struct stays untouched.
CONFIG_SECURITY_PATH=y
CONFIG_SECURITY_DEC=y
CONFIG_SECURITY_DEC_DEVELOP=y

# hisysevent — kernel-side hisysevent_write(), emits through hievent's
# /dev/bbox (already in stage 1).  Must be =y: zerohung links against it.
CONFIG_HISYSEVENT=y

# zerohung — zrhung_send_event used by hungtask + blackbox.  The
# hung_wp_screen watchpoint is inert here (no fb notifier on a DRM-only
# stack, powerkey entry point has no caller) — same as the X23.
CONFIG_DFX_ZEROHUNG=y

# hungtask — /sys/kernel/hungtask/{userlist,...}.  Ends the appspawn/
# nwebspawn/XCollie open-fail flood and arms the kernel watchdog kick
# for foundation.  Unlike the X23 (where the driver is dead code), the
# kernel/hung_task.c handoff hunks are applied, so this actually runs.
CONFIG_DFX_HUNGTASK=y
CONFIG_DFX_HUNGTASK_USER=y

# blackbox — fault-log framework, X23-parity inert configuration: no
# storage backend (a pstore backend would grow ramoops_platform_data
# and the pstore_type_id enum — both KMI-hostile).  Real paths so the
# save_error_log kthread parks on /data instead of polling forever.
CONFIG_BLACKBOX=y
CONFIG_BLACKBOX_LOG_ROOT_PATH="/data/log/bbox"
CONFIG_BLACKBOX_LOG_PART_REPRESENTATIVE="/data"

# ucollection — /dev/ucollection bulk CPU stats for hiview/hidumper.
# (Kconfig rewritten to plain bool: upstream's def_bool script check
# doesn't exist here, and the sources use unexported symbols so =m can
# never link.)
CONFIG_UNIFIED_COLLECTION=y
