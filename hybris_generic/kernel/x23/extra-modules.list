# MT6789 + MT6366 + AWINIC AW883xx audio stack.  These are second-stage
# (Android /vendor/lib/modules) modules — Halium's vendor_boot modules.load
# doesn't carry them, so native boot never loads them and no soundcard
# registers.  init.x23.cfg insmods them at pre-init in dependency order.
# See phase_n9_firmware_peripherals.md N9.5.
nvmem-mt635x-efuse.ko
mtk-afe-external.ko
scp.ko
adsp.ko
mtk-scp-audiocommon.ko
audio_ipi.ko
mtk-scp-audio.ko
snd-soc-audiodsp-common.ko
mtk-scp-ultra.ko
snd-soc-mtk-scp-ultra.ko
rps_perf.ko
ccmni.ko
ccci_util_lib.ko
ccci_auxadc.ko
ccci_md_all.ko
snd-soc-mtk-common.ko
mtk-sp-spk-amp.ko
smartpa.ko
mt6358-accdet.ko
snd-soc-mt6366.ko
snd-soc-mt6789-afe.ko
mtk-btcvsd.ko
mt6789-mt6366.ko

# MT6789 connsys (MediaTek WMT) WiFi stack.  Same second-stage-module
# problem as the audio + GPU stacks: the connsys driver set lives in the
# Android vendor_dlkm partition (/vendor/lib/modules), which native boot
# does not carry or load.  init.x23.cfg insmods them at pre-init in
# dependency order; `wmt_drv` must be followed by the wmtdetect-init
# helper (kernel WMT_init) before the wlan modules.  cfg80211.ko is
# already in Halium's vendor_boot modules.load, so it is not listed here.
# See phase_n9_firmware_peripherals.md N9.2.
connadp.ko
connfem.ko
btif_drv.ko
wmt_drv.ko
mddp.ko
wmt_chrdev_wifi.ko
wlan_drv_gen4m_6789.ko

# Sensor hub: hf_manager provides /dev/hf_manager (the MTK sensor-2.0 ABI the
# hybris sensor VDI reads); sensorhub registers the SCP-hosted sensors on it
# and needs scp.ko, so init.x23.cfg loads both right after the SCP modules.
hf_manager.ko
sensorhub.ko

# GNSS: gps_drv_stp (/dev/stpgps, on the WMT connsys) and gps_pwr — mnld's
# devices.  Loaded after wmt_drv; see the GNSS notes in init.x23.cfg.
gps_drv_stp.ko
gps_pwr.ko

# The rest of what Ubuntu Touch's vidofnir port loads at boot
# (overlay/system/usr/lib/modules-load.d/vidofnir.conf in the port repo),
# in dependency order, minus what OHOS cannot use or what could disturb it:
# USB network/gadget functions (c2k_usb*, asix, ax88179, mtk_u_ether,
# rndis), fingerprint, Bluetooth, voice wake-up, Widevine, the unused tfa98xx
# amp, and the extra ccci modem modules (ccci_dpmaif crashes the kernel when
# loaded this late).  This brings up the camera stack (imgsensor_isp6s, ISP,
# DIP, CCU, lens, flash, MDP), the JPEG/video codecs, thermal and power
# throttling, and the CPU/GPU performance helpers.  Order matters:
# camera_dip_isp6s probed out of this order resets the SoC.
mtk-swpm.ko
mtk-swpm-dbg-common-v1.ko
thermal_interface.ko
mtk-swpm-dbg-v6789.ko
gz_trusty_mod.ko
gz_ipc_mod.ko
