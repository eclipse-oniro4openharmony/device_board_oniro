# Phase A0 harness of docs/hybris_generic/audio_hal_switch_plan.md — see the
# comment header of test_audio_hal.c.

import("//build/ohos.gni")

ohos_executable("test_audio_hal") {
  sources = [ "test_audio_hal.c" ]

  include_dirs = [
    "//third_party/libhybris/hybris/include",
    "//third_party/android-headers",
  ]

  deps = [
    "//third_party/libhybris/hybris/common:libhybris-common",
    "//third_party/libhybris/hybris/hardware:libhardware",
  ]

  defines = [
    "ANDROID_VERSION_MAJOR=12",
    "RTLD_LAZY=1",
  ]

  cflags = [
    "-Wno-error=unused-function",
    "-Wno-error=missing-braces",
    "-Wno-error=#warnings",
  ]

  libs = [ "m" ]

  install_enable = true
  install_images = [ "system" ]
  part_name = "device_hybris_generic"
  subsystem_name = "device_hybris_generic"
}

group("test_audio_hal_group") {
  deps = [ ":test_audio_hal" ]
}
