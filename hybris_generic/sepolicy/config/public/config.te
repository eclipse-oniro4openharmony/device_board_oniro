# Product configuration Oniro installs on sys_prod for services and apps
# (stock OHOS keeps these readers on /system): the APN list, the window
# manager and brightness configuration, and the per-device overlays under
# /sys_prod/devices/<device> (camera profiles, display manager and HGM
# configuration).  Public data, readable by every domain.
type sys_prod_oniro_config_file, sys_prod_file_attr, file_attr;
