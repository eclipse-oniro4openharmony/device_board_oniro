typeattribute composer_host hybris_client;
typeattribute allocator_host hybris_client;
typeattribute render_service hybris_client;
typeattribute bootanimation hybris_client;
typeattribute camera_host hybris_client;
typeattribute audio_host hybris_client;
typeattribute codec_host hybris_client;
typeattribute av_codec_service hybris_client;
typeattribute riladapter_host hybris_client;
typeattribute location_host hybris_client;

# Halium partitions, /apex, the Android libraries the VDIs dlopen.
allow hybris_client halium_file:dir read_dir_perms;
allow hybris_client halium_file:file { read_file_perms execute map };
allow hybris_client halium_file:lnk_file { getattr read };
# Android labels most of Halium's /vendor (the partition root, lib64, many
# libraries) vendor_file, the name of OHOS's own /vendor type.  The HDI
# hosts are chipset domains and may use vendor code.
allow { hybris_client -sadomain -native_system_domain } vendor_file:dir { getattr search open read };
allow { hybris_client -sadomain -native_system_domain } vendor_file:lnk_file { getattr read };
allow { hybris_client -sadomain -native_system_domain } vendor_file:file { read_file_perms execute map };
# System-side clients (render_service, bootanimation, av_codec_service) load
# only libraries Android labels same_process_hal_file (halium_file); the
# EGL loader lists /vendor/lib64/egl on the way, the isolation rules'
# dir exceptions cover that.  /odm/lib64, a vendor_file link on the
# linker's search path, stays closed to them.
typeattribute render_service vendor_file_violator_dir_getattr;
typeattribute render_service vendor_file_violator_dir_open;
typeattribute render_service vendor_file_violator_dir_read;
typeattribute bootanimation vendor_file_violator_dir_getattr;
typeattribute bootanimation vendor_file_violator_dir_open;
typeattribute bootanimation vendor_file_violator_dir_read;
allow { render_service bootanimation } vendor_file:dir { getattr open read };
dontaudit { render_service bootanimation av_codec_service } vendor_file:lnk_file read;

# Android property area (libbase/libcutils property reads).
allow hybris_client halium_property:file { getattr open read map };
# ashmem regions and gralloc buffers handed over by Halium services.
allow hybris_client halium_device:chr_file { getattr ioctl map read write };
allow hybris_client halium_domain:fd use;

# The container's binder: AIDL HALs and the Android servicemanager.
allow hybris_client halium_binder_device:chr_file { getattr open read write ioctl map };
allow hybris_client halium_domain:binder { call transfer };
allow hybris_client dev_file:lnk_file read;    # /dev/{binder,hwbinder,vndbinder} links

# Mali GPU through the Android EGL/GLES stack.
allow hybris_client dev_mali:chr_file { getattr open read write ioctl map };
allow hybris_client hybris_proc_ged:file { getattr open read write ioctl };
allow hybris_client dev_dma_heap_file:dir { getattr search open read };
allow hybris_client dev_dma_heap_file:chr_file { getattr open read ioctl map };

# Android liblog also writes /dev/pmsg0; the line still reaches hilog.
dontaudit hybris_client dev_pmsg:chr_file { open write };

# Halium's /vendor/lib64/hw (and egl) are bound over OHOS's, so any dlopen
# search path through them hits a halium_file dir.  Harmless to refuse.
dontaudit domain halium_file:dir search;

# The RIL VDI looks the container's rild up by scanning /proc.
allow riladapter_host halium_domain:dir search;
allow riladapter_host halium_domain:file { getattr open read };
dontaudit riladapter_host domain:dir search;
dontaudit riladapter_host domain:file { getattr open read };

# Sensor hub (sensor VDI), BT controller (libbt_vendor).
allow sensor_host dev_hf_manager:chr_file { getattr open read write ioctl };
allow blue_host dev_stpbt:chr_file { getattr open read write ioctl };

# Halium's labels on its own tmpfs (/dev, /data, /dev/__properties__).
allow { halium_file halium_property halium_device } tmpfs:filesystem associate;
