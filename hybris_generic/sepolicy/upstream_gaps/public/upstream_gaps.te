# Domains named by the "secon" of OHOS 7.0 system services whose policy is
# not part of the 7.0 tree (selinux_adapter has no rules for them).  An
# unknown secon makes init's setexeccon fail and the service exit before it
# runs, in permissive mode too.  All four are on-demand system abilities.
type cast_engine_service, sadomain, domain;        # cast_engine_service.cfg
type fusion_ranging, sadomain, domain;             # fusion_ranging.cfg
type partner_device_agent, sadomain, domain;       # fusion_connectivity.cfg
type video_processing_service, sadomain, domain;   # video_processing_service.cfg
