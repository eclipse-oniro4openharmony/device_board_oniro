# The chainload (hybris_generic/launcher/init-chainload.sh) hands OHOS the
# ramdisk's devtmpfs as /dev and execs init straight into its second stage.
# Stock OHOS mounts a tmpfs on /dev in the first stage and ueventd creates
# every node already labeled; here the kernel creates the nodes, they carry
# the devtmpfs label `device` until init's restorecon of /dev after the
# policy load, and ueventd fixes the mode and owner of nodes that exist.

# dev_lperf and dev_graphics_file are reserved device types with no
# exception for init or ueventd; their nodes do not exist on this kernel.
allow init device:{ dir file chr_file blk_file lnk_file } { getattr relabelfrom };
allow init dev_attr:{ dir chr_file lnk_file } { getattr relabelto };
# The parameter service socket is created before the policy loads.
allow init device:sock_file { getattr relabelfrom };
allow init paramservice_socket:sock_file { getattr relabelto };
allow init { dev_attr -dev_lperf }:blk_file { getattr relabelto };
allow init proc_cmdline_file:file { getattr relabelto };
allow init dev_attr:dir { open read search };    # restorecon walks /dev

# The board cfgs (init.<device>.cfg) mount binderfs on /dev/binderfs and
# open its nodes up; devpts goes on /dev/pts.
allow init dev_file:filesystem mount;
allow init dev_file:dir { setattr remove_name rmdir };
allow init { dev_binder_file dev_hwbinder_file dev_vndbinder_file }:chr_file setattr;
allow init dev_pts_file:dir { mounton setattr };
allow init devpts:filesystem mount;
allow init dev_input_file:chr_file setattr;
# init logs to /dev/kmsg before its restorecon of /dev.
allow { init kernel } device:chr_file write;
allow init dev_bus_usb_file:dir { search write add_name create };

# appspawn.cfg mounts a pids cgroup on /dev/pids, which this kernel lacks:
# the directory stays on devtmpfs, labeled cgroup so appspawn's per-app
# pid directories work as they would on the cgroup.
allow cgroup device:filesystem associate;
allow init cgroup:dir { mounton relabelto };

allow ueventd device:{ chr_file blk_file lnk_file } { getattr setattr relabelfrom };
allow ueventd dev_attr:chr_file { getattr setattr relabelto };
allow ueventd { dev_attr -dev_lperf }:blk_file { getattr setattr relabelto };
allow ueventd dev_attr:dir { getattr search relabelto };
# Block devices that appear later (USB storage) are created unlabeled first.
allow ueventd dev_file:blk_file { create getattr setattr relabelfrom };
allow ueventd dev_file:lnk_file create;
# The vendor's device permissions (/vendor/etc/ueventd.config: owners of the
# MediaTek nodes the hybris VDIs open), behind OHOS's vendor-isolation
# exceptions.
typeattribute ueventd vendor_etc_file_violator_file_open;
typeattribute ueventd vendor_etc_file_violator_file_read;
typeattribute ueventd vendor_etc_file_violator_file_getattr;
allow ueventd vendor_etc_file:file { getattr open read };
allow ueventd sysfs_switch:dir { open read };

# devtmpfs also has the kernel create nodes for devices that appear after
# the policy load.  ueventd creates them anyway (its job on stock OHOS,
# where the kernel never does), and several device types are reserved to
# named domains, so the kernel's attempt is refused quietly.
dontaudit kernel dev_attr:dir { search write add_name remove_name };
dontaudit kernel dev_attr:{ chr_file blk_file } { create getattr setattr };

# Everything init and ueventd label under /dev lives on devtmpfs, including
# the parameter workspace files in /dev/__parameters__ and the socket dir.
allow { dev_attr parameter_attr } device:filesystem associate;
allow proc_cmdline_file device:filesystem associate;

# init reads the product and hardware parameter files
# (/sys_prod/etc/param/product_hybris_generic.para,
# /chip_prod/etc/param/hardware_hybris_generic.para).
allow init { sys_prod_file chip_prod_file }:dir { getattr open read search };
allow init { sys_prod_file chip_prod_file }:file { getattr open read };
