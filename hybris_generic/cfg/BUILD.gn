import("//build/ohos.gni")

# NOTE: the former hybris_graphic_env.cfg / z_hybris_hdf_env.cfg overlays
# (per-service LIBEGL/LIBGLESV2/HYBRIS_LD_LIBRARY_PATH/LD_LIBRARY_PATH/
# HYBRIS_EGLPLATFORM env vars) are gone: libhybris now compiles in
# equivalent defaults (third_party/libhybris/libhybris_args.gni), and the
# linker/EGL-platform plugins were always loaded by absolute path.  A
# device that needs different values can still override per-service via
# env in its init.<device>.cfg — the env vars keep priority over the
# compiled-in defaults.

ohos_prebuilt_etc("hybris_input_caps") {
  source = "z_multimodalinput_caps.cfg"
  relative_install_dir = "init"
  install_images = [ "system" ]
  part_name = "device_hybris_generic"
  subsystem_name = "device_hybris_generic"
}

group("hybris_input_caps_group") {
  deps = [ ":hybris_input_caps" ]
}

ohos_prebuilt_etc("hybris_hdcd_autostart") {
  source = "z_hdcd_autostart.cfg"
  relative_install_dir = "init"
  install_images = [ "system" ]
  part_name = "device_hybris_generic"
  subsystem_name = "device_hybris_generic"
}

group("hybris_hdcd_autostart_group") {
  deps = [ ":hybris_hdcd_autostart" ]
}

ohos_prebuilt_etc("hybris_device_node_perms") {
  source = "z_device_node_perms.cfg"
  relative_install_dir = "init"
  install_images = [ "system" ]
  part_name = "device_hybris_generic"
  subsystem_name = "device_hybris_generic"
}

group("hybris_device_node_perms_group") {
  deps = [ ":hybris_device_node_perms" ]
}

# Phase N8 — composer-ready gate.  Overlays composer_host/allocator_host
# with start-mode=condition gated on the OHOS param
# `android.composer.ready=1`, which the Phase N4 androidd watchdog
# flips once Halium's HIDL IComposer registers with hwservicemanager.
# Without this gate, those services start at OHOS init's boot trigger
# and SIGSEGV because the Halium HAL stack isn't up yet.
ohos_prebuilt_etc("hybris_composer_gate") {
  source = "z_composer_host_gate.cfg"
  relative_install_dir = "init"
  install_images = [ "system" ]
  part_name = "device_hybris_generic"
  subsystem_name = "device_hybris_generic"
}

group("hybris_composer_gate_group") {
  deps = [ ":hybris_composer_gate" ]
}
