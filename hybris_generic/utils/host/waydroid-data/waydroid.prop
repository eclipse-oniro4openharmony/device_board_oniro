# Generated for hybris_generic ansuz (W0, 2026-08-07) — mirrors upstream
# make_base_props()+make_prop() output for a Halium-14 MTK host.
ro.hardware.gralloc=android
ro.hardware.egl=mali
ro.hardware.vulkan=mali
ro.opengles.version=196610
ro.product.waydroid.brand=volla
ro.product.waydroid.device=ansuz
ro.product.waydroid.manufacturer=volla
ro.product.waydroid.model=Volla Phone Plinius
ro.product.waydroid.name=ansuz
ro.build.fingerprint=volla/ansuz/ansuz:15/AP3A.240905.015.A2/1:user/release-keys
waydroid.updater.disabled=true
waydroid.tools_version=1.7.0-oniro-native
waydroid.host.user=root
waydroid.host.uid=0
waydroid.host.gid=0
waydroid.host_data_path=/data/waydroid/data
# W3: boot in background (closed hwc mode), like upstream sessions do.
# Presetting waydroid.active_apps=Waydroid here crashes the hwc on SF's
# first EMPTY present: full-ui mode forwards the framebuffer-target
# layer whose handle is NULL until something client-composites, and the
# guard is a release-compiled-out assert (waydroid_mode_impl.h).  The
# switch to the full UI is a RUNTIME prop flip after sys.boot_completed
# (upstream show-full-ui does exactly this), when SF always has content.
waydroid.background_start=true
waydroid.xdg_runtime_dir=/run/xdg
waydroid.pulse_runtime_path=/run/xdg/pulse
waydroid.wayland_display=wayland-0
waydroid.stub_sensors_hal=1
ro.sf.lcd_density=480
