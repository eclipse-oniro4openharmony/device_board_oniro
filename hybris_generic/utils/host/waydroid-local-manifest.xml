<?xml version="1.0" encoding="UTF-8"?>
<!--
  Waydroid (Android app compatibility) overlay for a fresh tree.

  The Waydroid stack itself is on the public OpenHarmony-6.1-LTS branches of
  the BSP repos (and libhybris), built only when the product asks for it.
  What no upstream manifest has yet are the two vendored libraries the
  compositor links, libwayland-server and libffi; drop this file in as
  .repo/local_manifests/waydroid.xml before `repo sync` to get them.

  Then turn the feature on in vendor/oniro/hybris_generic/config.json — it is
  off by default (see device/soc/oniro/hybris_generic/waydroid/waydroid.gni):

    { "component": "hybris_generic_soc",
      "features": [ "hybris_generic_soc_feature_waydroid = true" ] },
    { "component": "libhybris",
      "features": [ "libhybris_enable_wayland = true" ] },
    { "component": "wayland",  "features": [] },
    { "component": "libffi",   "features": [] }

  Both are public forks: the upstream release tag plus one commit that only
  adds the OpenHarmony build files.  The whole first-boot walkthrough
  (build, flash, provision /data/waydroid) is in
  device/board/oniro/docs/hybris_generic/fresh_tree_waydroid.md
-->
<manifest>
  <remote name="frankplus" fetch="https://github.com/frankplus"/>

  <!-- Vendored for the Waydroid display bridge; no upstream OHOS component
       exists.  Protocol code is pregenerated, so no scanner runs at build
       time.  See each repo's BUILD.gn / regenerate.sh. -->
  <project name="wayland" path="third_party/wayland"
           remote="frankplus" revision="OpenHarmony-6.1-LTS"
           groups="default,ohos:standard,ohos:chipset"/>
  <project name="libffi" path="third_party/libffi"
           remote="frankplus" revision="OpenHarmony-6.1-LTS"
           groups="default,ohos:standard,ohos:chipset"/>
</manifest>
